h3 Save Output

.form-line
    .header
        .title Automatically save output for new tabs
        .description Stores complete session logs in a directory
    select.form-control(
        [(ngModel)]='config.store.saveOutput.autoSave',
        (ngModelChange)='config.save()'
    )
        option(ngValue='on') On
        option(ngValue='ssh') For SSH only
        option(ngValue='off') Off


.form-line
    .header
        .title Output directory
        .description Destination path for manual and automatic recordings
    .input-group
        input.form-control(
            type='text',
            placeholder='Home directory',
            [(ngModel)]='config.store.saveOutput.autoSaveDirectory',
            (ngModelChange)='config.save()'
        )
        .input-group-append
            button.btn.btn-secondary((click)='pickDirectory()')
                i.fas.fa-folder-open


.form-line
    .header
        .title Filename template
        .description Supports $(date +%Y%m%d%H%M%S), $(hostname)=session host, $(localHostname), $(title)
    input.form-control(
        type='text',
        [(ngModel)]='config.store.saveOutput.filenameTemplate',
        (ngModelChange)='config.save()',
        placeholder='$(date +%Y%m%d%H%M%S)-$(hostname).log'
    )

.form-line(*ngIf='previewFilename')
    .header
        .title Preview
        .description Example filename with the current template
    .text-muted {{ previewFilename }}


.form-line
    .header
        .title Insert line timestamps
        .description Prefix each log line with yyyy-mm-dd HH:MM:SS.xxx
    toggle(
        [(ngModel)]='config.store.saveOutput.insertTimestamps',
        (ngModelChange)='config.save()'
    )
